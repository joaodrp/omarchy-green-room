{
  "schemaVersion": 1,
  "id": "io.github.joaodrp.green-room",
  "name": "Green Room",
  "version": "0.1.0",
  "author": "João Pereira",
  "license": "MIT",
  "description": "One-click mirrored webcam and mic check from the Omarchy bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Green Room",
    "description": "Click the bar icon, see yourself in a mirrored live preview, with an optional mic level meter. Camera and mic are released when the panel closes.",
    "category": "Hardware",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "device": "auto",
      "mirror": true,
      "micCheck": false,
      "previewWidth": 560
    },
    "schema": [
      {
        "key": "device",
        "type": "string",
        "label": "Camera device id (auto = system default)",
        "defaultValue": "auto"
      },
      {
        "key": "mirror",
        "type": "boolean",
        "label": "Mirror the preview",
        "defaultValue": true
      },
      {
        "key": "micCheck",
        "type": "boolean",
        "label": "Show mic level meter",
        "defaultValue": false
      },
      {
        "key": "previewWidth",
        "type": "integer",
        "label": "Mirror width (px)",
        "min": 320,
        "max": 960,
        "step": 20,
        "defaultValue": 560
      }
    ]
  }
}
